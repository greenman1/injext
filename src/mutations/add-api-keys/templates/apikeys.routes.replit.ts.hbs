import crypto from 'crypto';
import { Router, Request, Response } from 'express';
import { db } from '{{dbFile}}';
import { apiKeys } from '../shared/schema';
import { eq, isNull } from 'drizzle-orm';
import { hashKey } from './apikeys.middleware';

const router = Router();

const PREFIX = process.env.API_KEY_PREFIX ?? 'sk_';

function generateRawKey(): string {
  return `${PREFIX}${crypto.randomBytes(32).toString('hex')}`;
}

// ─── POST / — generate key ────────────────────────────────────────────────────

router.post('/', async (req: Request, res: Response) => {
  try {
    const { name } = req.body as { name?: string };
    if (!name) {
      res.status(400).json({ error: 'name is required' });
      return;
    }

    const rawKey = generateRawKey();
    const keyHash = hashKey(rawKey);
    const prefix = rawKey.slice(0, PREFIX.length + 8);
    const userId = (req as any).user?.userId ? Number((req as any).user.userId) : null;

    const [record] = await db
      .insert(apiKeys)
      .values({ name, keyHash, prefix, userId })
      .returning();

    // Return the raw key ONCE — it is never stored
    res.status(201).json({ ...record, key: rawKey, keyHash: undefined });
  } catch (err) {
    console.error('[apikeys] generate error:', err);
    res.status(500).json({ error: 'Failed to generate API key' });
  }
});

// ─── GET / — list keys ────────────────────────────────────────────────────────

router.get('/', async (req: Request, res: Response) => {
  try {
    const userId = (req as any).user?.userId ? Number((req as any).user.userId) : null;
    const all = await db
      .select({
        id: apiKeys.id,
        name: apiKeys.name,
        prefix: apiKeys.prefix,
        userId: apiKeys.userId,
        revokedAt: apiKeys.revokedAt,
        lastUsedAt: apiKeys.lastUsedAt,
        createdAt: apiKeys.createdAt,
      })
      .from(apiKeys)
      .where(userId ? eq(apiKeys.userId, userId) : isNull(apiKeys.revokedAt));

    res.json(all);
  } catch (err) {
    res.status(500).json({ error: 'Failed to list API keys' });
  }
});

// ─── DELETE /:id — revoke ─────────────────────────────────────────────────────

router.delete('/:id', async (req: Request, res: Response) => {
  try {
    const [revoked] = await db
      .update(apiKeys)
      .set({ revokedAt: new Date() })
      .where(eq(apiKeys.id, Number(req.params.id)))
      .returning();

    if (!revoked) {
      res.status(404).json({ error: 'Key not found' });
      return;
    }
    res.json({ revoked: true });
  } catch (err) {
    res.status(500).json({ error: 'Failed to revoke key' });
  }
});

// ─── POST /:id/rotate ─────────────────────────────────────────────────────────

router.post('/:id/rotate', async (req: Request, res: Response) => {
  try {
    const [old] = await db
      .update(apiKeys)
      .set({ revokedAt: new Date() })
      .where(eq(apiKeys.id, Number(req.params.id)))
      .returning();

    if (!old) {
      res.status(404).json({ error: 'Key not found' });
      return;
    }

    const rawKey = generateRawKey();
    const [record] = await db
      .insert(apiKeys)
      .values({ name: old.name, keyHash: hashKey(rawKey), prefix: rawKey.slice(0, PREFIX.length + 8), userId: old.userId })
      .returning();

    res.status(201).json({ ...record, key: rawKey, keyHash: undefined });
  } catch (err) {
    res.status(500).json({ error: 'Failed to rotate key' });
  }
});

export default router;
