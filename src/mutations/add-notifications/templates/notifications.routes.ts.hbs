import { Router, Request, Response } from 'express';
import { notificationService } from './notifications.service';

const router = Router();

// ─── POST /send ───────────────────────────────────────────────────────────────

router.post('/send', async (req: Request, res: Response) => {
  const { to, subject, html } = req.body as { to?: string; subject?: string; html?: string };

  if (!to || !subject || !html) {
    res.status(400).json({ error: 'to, subject, and html are required' });
    return;
  }

  try {
    await notificationService.sendEmail(to, subject, html);
    res.json({ sent: true });
  } catch (err: any) {
    res.status(500).json({ error: 'Failed to send notification', message: err?.message });
  }
});

// ─── POST /enqueue ────────────────────────────────────────────────────────────

router.post('/enqueue', (req: Request, res: Response) => {
  const { to, subject, html } = req.body as { to?: string; subject?: string; html?: string };

  if (!to || !subject || !html) {
    res.status(400).json({ error: 'to, subject, and html are required' });
    return;
  }

  notificationService.enqueue(to, subject, html);
  res.json({ queued: true, queueLength: notificationService.getQueueLength() });
});

// ─── GET /queue ───────────────────────────────────────────────────────────────

router.get('/queue', (_req: Request, res: Response) => {
  res.json({ queueLength: notificationService.getQueueLength() });
});

export default router;
