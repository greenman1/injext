import { Router, Request, Response } from 'express';
import { requireAdmin } from './admin.middleware';

const router = Router();
router.use(requireAdmin);

interface AdminUser {
  id: number;
  email: string;
  role: string;
  createdAt: Date;
}

// In-memory user store — populated by add-auth's in-memory store if available
const adminUsers = new Map<number, AdminUser>();
let nextId = 1;

export function registerAdminUser(id: number, email: string, role = 'user'): void {
  adminUsers.set(id, { id, email, role, createdAt: new Date() });
}

// ─── GET /users ───────────────────────────────────────────────────────────────

router.get('/users', (req: Request, res: Response) => {
  const page = Math.max(1, Number(req.query.page ?? 1));
  const limit = 50;
  const users = Array.from(adminUsers.values()).slice((page - 1) * limit, page * limit);
  res.json(users);
});

// ─── GET /users/:id ───────────────────────────────────────────────────────────

router.get('/users/:id', (req: Request, res: Response) => {
  const user = adminUsers.get(Number(req.params.id));
  if (!user) { res.status(404).json({ error: 'User not found' }); return; }
  res.json(user);
});

// ─── PATCH /users/:id/role ────────────────────────────────────────────────────

router.patch('/users/:id/role', (req: Request, res: Response) => {
  const id = Number(req.params.id);
  const user = adminUsers.get(id);
  if (!user) { res.status(404).json({ error: 'User not found' }); return; }
  const { role } = req.body as { role?: string };
  if (!role) { res.status(400).json({ error: 'role is required' }); return; }
  adminUsers.set(id, { ...user, role });
  res.json({ id, role });
});

// ─── DELETE /users/:id ────────────────────────────────────────────────────────

router.delete('/users/:id', (req: Request, res: Response) => {
  const deleted = adminUsers.delete(Number(req.params.id));
  if (!deleted) { res.status(404).json({ error: 'User not found' }); return; }
  res.json({ deleted: true });
});

// ─── GET /stats ───────────────────────────────────────────────────────────────

router.get('/stats', (_req: Request, res: Response) => {
  const users = Array.from(adminUsers.values());
  res.json({
    totalUsers: users.length,
    adminRoles: users.filter(u => u.role === 'admin').length,
  });
});

export default router;
