import { Router, Request, Response } from 'express';
import { db } from '{{dbFile}}';
import { adminUserRoles } from '../shared/schema';
import { eq, sql } from 'drizzle-orm';
import { requireAdmin } from './admin.middleware';

const router = Router();
router.use(requireAdmin);

// Try to import authUsers if add-auth is installed
let authUsersTable: any = null;
try {
  // eslint-disable-next-line @typescript-eslint/no-var-requires
  const schema = require('../shared/schema');
  if (schema.authUsers) authUsersTable = schema.authUsers;
} catch { /* add-auth not installed */ }

// ─── GET /users ───────────────────────────────────────────────────────────────

router.get('/users', async (req: Request, res: Response) => {
  try {
    const page = Math.max(1, Number(req.query.page ?? 1));
    const limit = 50;
    const offset = (page - 1) * limit;

    if (authUsersTable) {
      const users = await db
        .select()
        .from(authUsersTable)
        .limit(limit)
        .offset(offset);
      res.json(users.map((u: any) => ({ ...u, passwordHash: undefined })));
    } else {
      const roles = await db.select().from(adminUserRoles).limit(limit).offset(offset);
      res.json(roles);
    }
  } catch (err) {
    res.status(500).json({ error: 'Failed to list users' });
  }
});

// ─── GET /users/:id ───────────────────────────────────────────────────────────

router.get('/users/:id', async (req: Request, res: Response) => {
  try {
    const id = Number(req.params.id);
    if (authUsersTable) {
      const [user] = await db.select().from(authUsersTable).where(eq(authUsersTable.id, id)).limit(1);
      if (!user) { res.status(404).json({ error: 'User not found' }); return; }
      res.json({ ...user, passwordHash: undefined });
    } else {
      const [role] = await db.select().from(adminUserRoles).where(eq(adminUserRoles.userId, id)).limit(1);
      if (!role) { res.status(404).json({ error: 'User not found' }); return; }
      res.json(role);
    }
  } catch (err) {
    res.status(500).json({ error: 'Failed to get user' });
  }
});

// ─── PATCH /users/:id/role ────────────────────────────────────────────────────

router.patch('/users/:id/role', async (req: Request, res: Response) => {
  try {
    const userId = Number(req.params.id);
    const { role } = req.body as { role?: string };
    if (!role) { res.status(400).json({ error: 'role is required' }); return; }

    const existing = await db.select().from(adminUserRoles).where(eq(adminUserRoles.userId, userId)).limit(1);
    if (existing.length > 0) {
      await db.update(adminUserRoles).set({ role }).where(eq(adminUserRoles.userId, userId));
    } else {
      await db.insert(adminUserRoles).values({ userId, role });
    }
    res.json({ userId, role });
  } catch (err) {
    res.status(500).json({ error: 'Failed to update role' });
  }
});

// ─── DELETE /users/:id ────────────────────────────────────────────────────────

router.delete('/users/:id', async (req: Request, res: Response) => {
  try {
    const id = Number(req.params.id);
    if (authUsersTable) {
      await db.delete(authUsersTable).where(eq(authUsersTable.id, id));
    }
    await db.delete(adminUserRoles).where(eq(adminUserRoles.userId, id)).catch(() => {});
    res.json({ deleted: true });
  } catch (err) {
    res.status(500).json({ error: 'Failed to delete user' });
  }
});

// ─── GET /stats ───────────────────────────────────────────────────────────────

router.get('/stats', async (_req: Request, res: Response) => {
  try {
    const [roleStats] = await db
      .select({ count: sql<number>`count(*)::int` })
      .from(adminUserRoles);

    const adminCount = await db
      .select({ count: sql<number>`count(*)::int` })
      .from(adminUserRoles)
      .where(eq(adminUserRoles.role, 'admin'));

    let userCount = 0;
    if (authUsersTable) {
      const [uc] = await db.select({ count: sql<number>`count(*)::int` }).from(authUsersTable);
      userCount = uc?.count ?? 0;
    }

    res.json({
      totalUsers: userCount || roleStats?.count,
      adminRoles: adminCount[0]?.count ?? 0,
    });
  } catch (err) {
    res.status(500).json({ error: 'Failed to get stats' });
  }
});

export default router;
