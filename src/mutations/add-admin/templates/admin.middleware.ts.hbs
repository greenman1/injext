import { timingSafeEqual } from 'node:crypto';
import { Request, Response, NextFunction } from 'express';

// ─── requireAdmin Middleware ──────────────────────────────────────────────────
// Protects admin routes with either:
// 1. An add-auth JWT whose signed role claim is "admin".
// 2. A deployment-specific bootstrap/fallback secret:
//    X-Admin-Secret: <value of ADMIN_SECRET env var>
//
// To set ADMIN_SECRET, add it to your .env file:
//   ADMIN_SECRET=$(node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))')

function secretsMatch(provided: string | string[] | undefined, expected: string): boolean {
  if (typeof provided !== 'string') return false;

  const providedBytes = Buffer.from(provided, 'utf8');
  const expectedBytes = Buffer.from(expected, 'utf8');
  return (
    providedBytes.length === expectedBytes.length &&
    timingSafeEqual(providedBytes, expectedBytes)
  );
}

export function requireAdmin(req: Request, res: Response, next: NextFunction): void {
  const user = (req as any).user;
  if (user?.role === 'admin') {
    next();
    return;
  }

  const secret = process.env.ADMIN_SECRET;
  if (secret && secretsMatch(req.headers['x-admin-secret'], secret)) {
    next();
    return;
  }

  res.status(403).json({ error: 'Admin access required' });
}
