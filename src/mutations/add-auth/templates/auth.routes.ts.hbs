import { Router, Request, Response } from 'express';
import bcrypt from 'bcryptjs';
import jwt from 'jsonwebtoken';

const router = Router();

// ─── In-memory user store (MVP — replace with DB in production) ───────────────

interface StoredUser {
  id: string;
  email: string;
  password: string; // bcrypt hash
}

const users: StoredUser[] = [];

// ─── POST /register ───────────────────────────────────────────────────────────

router.post('/register', async (req: Request, res: Response) => {
  try {
    const { email, password } = req.body as { email?: string; password?: string };

    if (!email || !password) {
      res.status(400).json({ error: 'email and password are required' });
      return;
    }

    if (users.find(u => u.email === email)) {
      res.status(409).json({ error: 'A user with this email already exists' });
      return;
    }

    const salt = await bcrypt.genSalt(12);
    const passwordHash = await bcrypt.hash(password, salt);
    const id = `user_${Date.now()}`;

    users.push({ id, email, password: passwordHash });

    res.status(201).json({ id, email });
  } catch (err) {
    res.status(500).json({ error: 'Registration failed' });
  }
});

// ─── POST /login ──────────────────────────────────────────────────────────────

router.post('/login', async (req: Request, res: Response) => {
  try {
    const { email, password } = req.body as { email?: string; password?: string };

    if (!email || !password) {
      res.status(400).json({ error: 'email and password are required' });
      return;
    }

    const user = users.find(u => u.email === email);
    if (!user) {
      res.status(401).json({ error: 'Invalid credentials' });
      return;
    }

    const valid = await bcrypt.compare(password, user.password);
    if (!valid) {
      res.status(401).json({ error: 'Invalid credentials' });
      return;
    }

    const secret = process.env.JWT_SECRET;
    const expiry = process.env.JWT_EXPIRY ?? '7d';

    if (!secret) {
      res.status(500).json({ error: 'Auth misconfiguration: JWT_SECRET not set' });
      return;
    }

    const token = jwt.sign(
      { userId: user.id, email: user.email },
      secret,
      { expiresIn: expiry } as jwt.SignOptions
    );

    res.status(200).json({ token, expiresIn: expiry });
  } catch (err) {
    res.status(500).json({ error: 'Login failed' });
  }
});

// ─── GET /me ──────────────────────────────────────────────────────────────────

router.get('/me', (req: Request, res: Response) => {
  if (!req.user) {
    res.status(401).json({ error: 'Not authenticated' });
    return;
  }
  res.json({ userId: req.user.userId, email: req.user.email });
});

export default router;
