import { Router, Request, Response } from 'express';
import { jobQueue } from './jobs.service';
import { jobRegistry, registerDefaultJobs } from './jobs.registry';

// Register default jobs at startup
registerDefaultJobs();

const router = Router();

// ─── POST /enqueue ─────────────────────────────────────────────────────────────

router.post('/enqueue', (req: Request, res: Response) => {
  const { name, payload, maxRetries } = req.body as {
    name?: string;
    payload?: unknown;
    maxRetries?: number;
  };

  if (!name) {
    res.status(400).json({ error: 'name is required' });
    return;
  }

  if (!jobRegistry.list().includes(name)) {
    res.status(400).json({ error: `Unknown job name "${name}". Registered: ${jobRegistry.list().join(', ')}` });
    return;
  }

  const job = jobQueue.enqueue(name, payload ?? {}, { maxRetries });
  res.status(201).json(job);
});

// ─── GET / ────────────────────────────────────────────────────────────────────

router.get('/', (_req: Request, res: Response) => {
  res.json(jobQueue.getAll());
});

// ─── GET /stats ───────────────────────────────────────────────────────────────

router.get('/stats', (_req: Request, res: Response) => {
  res.json(jobQueue.getStats());
});

// ─── GET /:id ─────────────────────────────────────────────────────────────────

router.get('/:id', (req: Request, res: Response) => {
  const job = jobQueue.getById(req.params.id);
  if (!job) {
    res.status(404).json({ error: 'Job not found' });
    return;
  }
  res.json(job);
});

// ─── DELETE /:id ──────────────────────────────────────────────────────────────

router.delete('/:id', (req: Request, res: Response) => {
  const cancelled = jobQueue.cancel(req.params.id);
  if (!cancelled) {
    res.status(404).json({ error: 'Job not found or already running/completed' });
    return;
  }
  res.json({ cancelled: true });
});

export default router;
